# ==============================================================================
# WEB SEO AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Note: Placeholders only. Copy to .env in backend/ and frontend/ as needed.
# Do NOT commit real secrets or credentials to source control.

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="Web SEO AI"
APP_ENV=local
APP_KEY=base64:PLACEHOLDER_RUN_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (POSTGRESQL PRIMARY / SQLITE LOCAL)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=web_seo_ai
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Optional: SQLite local fallback for zero-config testing
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

# ------------------------------------------------------------------------------
# CACHE, QUEUE & REDIS
# ------------------------------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# OBJECT STORAGE (SNAPSHOTS & AUDIT REPORTS)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
# For AWS S3 / Cloudflare R2 / MinIO:
AWS_ACCESS_KEY_ID=your_storage_access_key
AWS_SECRET_ACCESS_KEY=your_storage_secret_key
AWS_DEFAULT_REGION=auto
AWS_BUCKET=web-seo-ai-reports
AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# AI PROVIDERS (UNIFIED GATEWAY)
# ------------------------------------------------------------------------------
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.5-flash

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# GOOGLE SEARCH CONSOLE INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback

# ------------------------------------------------------------------------------
# CRAWLER ENGINE TUNING & SAFETY
# ------------------------------------------------------------------------------
CRAWLER_USER_AGENT="WebSeoAi-Bot/1.0 (+https://techboloy.com/bot)"
CRAWLER_DEFAULT_MAX_PAGES=250
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_DELAY_BETWEEN_REQUESTS_MS=500
CRAWLER_RESPECT_ROBOTS_TXT=true

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SESSION_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
